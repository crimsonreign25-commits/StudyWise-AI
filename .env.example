# Configure one or more providers. Gemini -> Grok -> OpenAI by default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: override Gemini API base only when your provider setup requires it
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
XAI_API_KEY=
GROK_MODEL=grok-3-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_ORDER=gemini,grok,openai
# Optional: comma-separated origins if API and UI later use separate domains
ALLOWED_ORIGIN=
PORT=10000

# Required only for one-time Creator / Super Admin bootstrap. Generate a long random secret.
CREATOR_SETUP_SECRET=
# Optional: isolate local development data directory
STUDYWISE_DATA_DIR=
