# Required for secure account/session/role features. Use a managed PostgreSQL database on Render.
DATABASE_URL=
# Generate a long random secret; keep it only in Render environment settings. Never commit it.
CREATOR_BOOTSTRAP_SECRET=

# AI provider keys are optional; keep keys server-side and never put them in frontend files.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
XAI_API_KEY=
GROK_MODEL=grok-3-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER_ORDER=gemini,groq,grok,openai
ALLOWED_ORIGIN=
PORT=10000
